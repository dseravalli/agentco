{
  "name": "agentco",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@agentco/orchestrator' --filter '@agentco/tui' dev",
    "build": "bun run --workspaces build",
    "format": "bun run --workspaces format",
    "lint": "bun run --workspaces lint",
    "typecheck": "bun run --workspaces typecheck",
    "cli": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1"
  }
}
